# DSpace
DSPACE_NAME=DSpace Docker
DSPACE_SOLR_URL=http://dspacesolr:8983/solr

# PostgreSQL
DSPACE_DB_NAME=dspace
DSPACE_DB_USER=dspace
DSPACE_DB_PASSWORD=replace-with-a-strong-password
DSPACE_DB_URL=jdbc:postgresql://dspacedb:5432/dspace

# Host directories mounted into containers. Use absolute paths.
DSPACE_ASSETSTORE_DIR=/home/your-user/dspace-structure/assetstore
DSPACE_CONFIG_DIR=/home/your-user/dspace-structure/config
POSTGRES_DATA_DIR=/home/your-user/dspace-structure/volumes/postgres-data
SOLR_DATA_DIR=/home/your-user/dspace-structure/volumes/solr-data