# Dados/runtime dos containers
assetstore/*
volumes/postgres-data/*
volumes/solr-data/*

# Mantém a estrutura dos diretórios
!assetstore/.gitkeep
!volumes/postgres-data/.gitkeep
!volumes/solr-data/.gitkeep

# Dados temporários
data/*
!data/.gitkeep

# Configuração gerada/local
config/*
!config/.gitkeep

# Logs
*.log

# Backups
*.sql
*.dump
*.backup
*.tar
*.tar.gz
*.zip

# Credenciais
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Configuração local com possíveis senhas
config/local.cfg
